{
  "expo": {
    "name": "PulseClass",
    "slug": "pulseclass",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pulseclass",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulseclass.app"
    },
    "android": {
      "package": "com.pulseclass.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
