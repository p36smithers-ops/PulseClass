{
  "expo": {
    "name": "PulseClass Student",
    "slug": "pulseclass-student",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ie.pulseclass.student",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "PulseClass uses Bluetooth to connect to your heart-rate monitor during a PE or sports science lesson."
      }
    },
    "android": {
      "package": "ie.pulseclass.student",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "PulseClass uses Bluetooth to connect to your heart-rate monitor during a lesson."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {}
    }
  }
}
